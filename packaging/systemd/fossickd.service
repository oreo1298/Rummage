[Unit]
Description=Fossick file name index
Documentation=https://github.com/oreo1298/Rummage/blob/main/README.md
After=local-fs.target
Requires=fossickd.socket
After=fossickd.socket

[Service]
Type=simple
ExecStart=/usr/bin/fossickd
User=fossick
Group=fossick
# fanotify filesystem marks need CAP_SYS_ADMIN; reading every directory and resolving
# fanotify file handles need CAP_DAC_READ_SEARCH. Nothing else.
AmbientCapabilities=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
# The whole filesystem is read-only to the daemon except its state and runtime directories.
ProtectSystem=strict
ProtectHome=read-only
# A private /tmp: the host's /tmp and /var/tmp are therefore not indexed (docs/FILESYSTEMS.md).
PrivateTmp=yes
StateDirectory=fossick
StateDirectoryMode=0700
RuntimeDirectory=fossick
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0077
# Only the client socket. The optional HTTP server (Phase 6) adds AF_INET/AF_INET6 in a drop-in.
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service fanotify_init fanotify_mark name_to_handle_at open_by_handle_at
SystemCallErrorNumber=EPERM
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# /dev stays visible: filesystem UUIDs are read from /dev/disk/by-uuid.
PrivateDevices=no
# Scanner threads lower themselves to idle I/O priority and nice 19; queries keep normal
# priority.
Restart=on-failure
RestartSec=2
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
Also=fossickd.socket
